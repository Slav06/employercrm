# Leave unset to use the embedded local Postgres (PGlite) in ./data/pglite.
# Set to a Neon/Postgres URL to use a real database (needed before deploying).
DATABASE_URL=

# Required to call POST /api/fetch (e.g. from cron).
CRON_SECRET=change-me

# Politeness knobs for the Craigslist fetcher.
CL_DELAY_MS=3000
CL_MAX_NEW_PER_SEARCH=60

# Gmail (company Google Workspace). See README → Gmail setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_KEY=
# Optional: only allow mailboxes on these domains (comma-separated), e.g. acme.com,acme.io
GOOGLE_WORKSPACE_DOMAIN=
